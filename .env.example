# Variables de compilación de la aplicación web (Vite).
# Copia este fichero como .env.local. Las variables VITE_* acaban en el bundle público:
# no pongas secretos. Todos los valores de abajo son los públicos de la instancia de EDUmind.

# Inicio de sesión OIDC (Authentik). Cambia ambos si usas tu propio proveedor.
VITE_OIDC_AUTHORITY=https://auth.edumind.es/application/o/motion-v1/
VITE_OIDC_CLIENT_ID=91c7eca1b29c43c90ea1eb5d96747d51
VITE_APP_DOMAIN=https://motion.edumind.es
VITE_SHELL_URL=https://edumind.es/dashboard

# API de proyectos en la nube y galería (carpeta server/). Si se deja vacía o no se
# define, la app funciona igual: los proyectos se quedan en el navegador.
VITE_API_URL=https://motion.edumind.es/motion-api
