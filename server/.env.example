# Configuración del servidor API Motion EDUmind
# Copia este archivo como .env y ajusta los valores

PORT=3210
NODE_ENV=production

# OIDC — mismo authority que el frontend
OIDC_AUTHORITY=https://auth.edumind.es/application/o/motion-v1/
OIDC_CLIENT_ID=91c7eca1b29c43c90ea1eb5d96747d51

# Orígenes permitidos en CORS (separados por coma)
CORS_ORIGINS=https://motion.edumind.es,http://localhost:5173

# Ruta de la base de datos SQLite
DB_PATH=./motion_api.db
